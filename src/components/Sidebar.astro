---
import Icon from './Icon.astro'
import { NAV_GROUPS } from '~/lib/site'

interface Props { active?: string }
const { active = '/' } = Astro.props
const isActive = (href: string) => href === '/' ? active === '/' : active === href || active.startsWith(`${href}/`)
---

<aside class="sidebar" id="site-sidebar" aria-label="Primary navigation">
  <nav class="file-tree">
    <a class:list={['tree-row', { active: active === '/' }]} href="/">
      <Icon name="file" /> <span>readme.md</span>
    </a>
    {NAV_GROUPS.map((group) => 'children' in group ? (
      <details open={group.href !== '/favorites' || isActive(group.href)} class="tree-group">
        <summary class:list={['tree-row', { active: isActive(group.href) && !group.children.some((child) => isActive(child.href)) }]}>
          <span class="tree-summary-label"><Icon name={group.href === '/blogs' ? 'folder' : group.href === '/favorites' ? 'star' : 'user'} /> {group.label}</span>
          <Icon name="chevron" size={13} />
        </summary>
        <div class="tree-children">
          {group.children.map((child) => (
            <a class:list={['tree-row', { active: child.href === group.href ? active === child.href : isActive(child.href) }]} href={child.href}>
              <Icon name="folder" /> <span>{child.label}</span>
            </a>
          ))}
        </div>
      </details>
    ) : (
      <a class:list={['tree-row', { active: isActive(group.href) }]} href={group.href}>
        <Icon name={group.href === '/projects' ? 'cube' : 'calendar'} />
        <span>{group.label}</span>
      </a>
    ))}
  </nav>
</aside>
