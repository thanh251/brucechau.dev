---
import Icon from './Icon.astro'
---

<div class="theme-toggle" aria-label="Theme preference">
  <button type="button" data-theme-value="light" aria-label="Use light theme"><Icon name="sun" size={14} /></button>
  <button type="button" data-theme-value="dark" aria-label="Use dark theme"><Icon name="moon" size={14} /></button>
  <button type="button" data-theme-value="system" aria-label="Use system theme"><Icon name="monitor" size={14} /></button>
</div>
