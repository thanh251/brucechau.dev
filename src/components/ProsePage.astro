---
interface Props {
  eyebrow?: string
  title: string
  description: string
}
const { eyebrow, title, description } = Astro.props
---

<div class="content-page">
  <header class="content-page__hero">
    {eyebrow && <span>{eyebrow}</span>}
    <h1>{title}</h1>
    <p>{description}</p>
  </header>
  <div class="content-page__body"><slot /></div>
</div>
