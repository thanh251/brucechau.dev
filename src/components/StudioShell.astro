---
import Icon from './Icon.astro'
import SearchPalette from './SearchPalette.astro'
import Sidebar from './Sidebar.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  active?: string
  filename?: string
}

const { active = Astro.url.pathname, filename = 'README.md' } = Astro.props
---

<div class="desktop-frame exhibition-shell" data-home={active === '/'} data-filename={filename}>
  <header class="titlebar">
    <button class="icon-button mobile-only" type="button" data-toggle-sidebar aria-label="Open navigation menu" aria-controls="site-sidebar" aria-expanded="false"><Icon name="panel" /></button>
    <a class="titlebar__path" href="/" aria-label="Bruce Chau home">
      <svg class="brand-mark" viewBox="0 0 260 260" aria-hidden="true" focusable="false">
        <path d="M205 64A99 99 0 1 0 226 123" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="square" />
        <path d="M217 82 229 108 205 108Z" fill="var(--blue)" />
        <path d="M81 63H141C170 63 184 76 184 97C184 113 176 123 161 129C180 134 191 147 191 165C191 188 173 200 142 200H81ZM110 88V117H137C148 117 154 112 154 102S148 88 137 88ZM110 143V175H139C153 175 160 169 160 159S153 143 139 143Z" fill="currentColor" fill-rule="evenodd" />
        <path d="m123 171 14-22 14 22Z" fill="var(--cubist-yellow)" />
      </svg>
      <span class="brand-word" aria-hidden="true">BRU</span>
    </a>
    <nav class="top-nav" aria-label="Site navigation">
      <a href="/">home</a>
      <div class="top-nav__group" data-nav-dropdown>
        <a class="top-nav__trigger" href="/blogs" aria-expanded="false" aria-controls="blogs-menu">blogs <Icon name="chevron" size={12} /></a>
        <div class="top-nav__menu" id="blogs-menu">
          <a href="/blogs">all writing</a>
          <a href="/blogs/tech">tech</a>
          <a href="/blogs/health">health</a>
          <a href="/blogs/ideas">ideas</a>
        </div>
      </div>
      <a href="/favorites">favorites</a>
      <div class="top-nav__group" data-nav-dropdown>
        <a class="top-nav__trigger" href="/about/whoami" aria-expanded="false" aria-controls="about-menu">about <Icon name="chevron" size={12} /></a>
        <div class="top-nav__menu" id="about-menu">
          <a href="/about/whoami">whoami</a>
          <a href="/about/uses">uses</a>
          <a href="/about/inspiration">inspiration</a>
          <a href="/about/collections">collections</a>
          <a href="/about/setup">setup</a>
        </div>
      </div>
      <a href="/projects">projects</a>
      <a href="/calendar">calendar</a>
    </nav>
    <div class="titlebar__actions">
      <button class="search-button" type="button" data-open-search aria-label="Search this site"><Icon name="search" /></button>
      <ThemeToggle />
    </div>
  </header>
  <SearchPalette />
  <Sidebar active={active} />
  <main class="main-pane">
    <div class="page-scroll"><slot /></div>
  </main>
</div>
<div class="mobile-backdrop" data-backdrop></div>

<script>
  const navGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dropdown]'))
  const setOpenNavGroup = (activeGroup: HTMLElement | null) => {
    for (const group of navGroups) {
      const isOpen = group === activeGroup
      group.classList.toggle('is-open', isOpen)
      group.querySelector('.top-nav__trigger')?.setAttribute('aria-expanded', String(isOpen))
    }
  }
  for (const group of navGroups) {
    group.addEventListener('pointerenter', () => setOpenNavGroup(group))
    group.addEventListener('pointerleave', () => setOpenNavGroup(null))
    group.addEventListener('focusin', () => setOpenNavGroup(group))
    group.addEventListener('focusout', (event) => {
      if (!group.contains(event.relatedTarget as Node | null)) setOpenNavGroup(null)
    })
    group.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      group.querySelector<HTMLElement>('.top-nav__trigger')?.focus()
      setOpenNavGroup(null)
      event.preventDefault()
    })
  }

  const frame = document.querySelector<HTMLElement>('.desktop-frame')
  const backdrop = document.querySelector<HTMLElement>('[data-backdrop]')
  const sidebar = document.querySelector<HTMLElement>('#site-sidebar')
  const sidebarToggle = document.querySelector<HTMLButtonElement>('[data-toggle-sidebar]')
  const drawerQuery = matchMedia('(max-width: 1100px)')
  const syncBackdrop = () => {
    const open = frame?.classList.contains('sidebar-open')
    backdrop?.classList.toggle('visible', Boolean(open))
    document.body.classList.toggle('drawer-open', Boolean(open))
  }
  const setSidebarOpen = (open: boolean, restoreFocus = false) => {
    frame?.classList.toggle('sidebar-open', open)
    sidebarToggle?.setAttribute('aria-expanded', String(open))
    sidebarToggle?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu')
    if (drawerQuery.matches) {
      sidebar?.toggleAttribute('inert', !open)
      sidebar?.setAttribute('aria-hidden', String(!open))
    } else {
      sidebar?.removeAttribute('inert')
      sidebar?.removeAttribute('aria-hidden')
    }
    if (open) sidebar?.querySelector<HTMLElement>('a, summary')?.focus()
    else if (restoreFocus) sidebarToggle?.focus()
    syncBackdrop()
  }
  const closeDrawers = () => {
    const sidebarWasOpen = frame?.classList.contains('sidebar-open') ?? false
    setSidebarOpen(false, sidebarWasOpen)
  }
  sidebarToggle?.addEventListener('click', () => {
    setSidebarOpen(!frame?.classList.contains('sidebar-open'))
  })
  backdrop?.addEventListener('click', closeDrawers)
  document.querySelector('#site-sidebar')?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setSidebarOpen(false)
  })
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDrawers()
  })
  drawerQuery.addEventListener('change', () => {
    setSidebarOpen(false)
  })
  setSidebarOpen(false)
</script>
