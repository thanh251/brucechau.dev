---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StudioShell from '~/components/StudioShell.astro'
import ProsePage from '~/components/ProsePage.astro'
import { usesContent } from '~/data/uses'
---

<BaseLayout title="Uses — Bruce Chau">
  <StudioShell active="/about/uses" filename="about/uses.md">
    <ProsePage eyebrow={usesContent.eyebrow} title={usesContent.title} description={usesContent.description}>
      <div class="collection-grid">
        {usesContent.categories.map((category) => (
          'href' in category
            ? <a class="content-card uses-category-link" href={category.href}>
                <h3>{category.title}</h3>
                <p>{category.description}</p>
                <span>Explore {category.title.toLowerCase()} <span aria-hidden="true">→</span></span>
              </a>
            : <article class="content-card"><h3>{category.title}</h3><p>{category.description}</p></article>
        ))}
      </div>
    </ProsePage>
  </StudioShell>
</BaseLayout>
