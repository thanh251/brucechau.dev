---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StudioShell from '~/components/StudioShell.astro'
import ProsePage from '~/components/ProsePage.astro'
import { whoamiContent } from '~/data/whoami'
---

<BaseLayout title={`${whoamiContent.title} — Bruce Chau`}>
  <StudioShell active="/about/whoami" filename="about/whoami.md">
    <ProsePage eyebrow={whoamiContent.eyebrow} title={whoamiContent.title} description={whoamiContent.description}>
      {whoamiContent.introduction.map((paragraph) => <p>{paragraph}</p>)}
      {whoamiContent.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {section.points && <ul>{section.points.map((point) => <li>{point}</li>)}</ul>}
        </section>
      ))}
    </ProsePage>
  </StudioShell>
</BaseLayout>
