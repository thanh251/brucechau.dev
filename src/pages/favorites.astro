---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StudioShell from '~/components/StudioShell.astro'
import ProsePage from '~/components/ProsePage.astro'
import { favoriteCategories, favoriteHref } from '~/data/favorites'
---

<BaseLayout title="Favorites — Bruce Chau">
  <StudioShell active="/favorites" filename="favorites.md">
    <ProsePage eyebrow="personal index" title="Favorites" description="Things I return to, recommend, or simply want to remember.">
      <div class="collection-grid">
        {favoriteCategories.map(({ label, slug, description }) => (
          <a class="content-card favorite-category" href={favoriteHref(slug)}>
            <h3>{label}</h3>
            <p>{description}</p>
            <span>Explore collection →</span>
          </a>
        ))}
      </div>
    </ProsePage>
  </StudioShell>
</BaseLayout>
