---
import { getCollection } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import StudioShell from '~/components/StudioShell.astro'
import SocialLinks from '~/components/SocialLinks.astro'
import SectionHeader from '~/components/SectionHeader.astro'
import CareerPath from '~/components/CareerPath'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3)
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' })
const name = 'Bruce Chau'
---

<BaseLayout>
  <StudioShell active="/" filename="README.md">
    <div class="home">
      <section class="hero">
        <span class="hero__edge" aria-hidden="true"></span>
        <div class="hero__content">
          <div class="hero__index" aria-hidden="true"><span>01</span><i></i></div>
          <h1 aria-label={name}>{Array.from(name).map((letter, index) => letter === ' ' ? <span class="hero__name-space" aria-hidden="true"> </span> : <span class="hero__name-letter" data-letter={index} aria-hidden="true">{letter}</span>)}</h1>
          <p class="hero__lede">Developer, builder, and lifelong learner.<br />I write about software, health, and unfinished ideas.</p>
          <p class="now-line">Studying at PTIT · Building with Weaverse</p>
          <SocialLinks />
        </div>
      </section>

      <section class="home-section home-section--writing">
        <SectionHeader index="02" title="Featured Writing" href="/blogs" />
        <div class="post-list">
          {featuredPosts.map((post, index) => (
            <a class="post-row" href={`/blog/${post.id}`}>
              <span class="post-row__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <strong>{post.data.title}</strong>
              <span>{post.data.category}</span>
              <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
            </a>
          ))}
        </div>
      </section>

      <section class="home-section home-section--projects">
        <SectionHeader index="03" title="Selected Projects" href="/projects" />
        <div class="project-list">
          <a class="project-item" href="/projects">
            <span>01</span>
            <h3>brucechau.dev</h3>
            <p>A quiet corner of the internet for notes, experiments, and things worth remembering.</p>
            <small>Astro · React · MDX</small>
          </a>
          <a class="project-item" href="/projects">
            <span>02</span>
            <h3>Small useful tools</h3>
            <p>Exploring products that remove friction from learning, building, and everyday work.</p>
            <small>TypeScript · Product craft</small>
          </a>
        </div>
      </section>

      <CareerPath client:visible />
    </div>
  </StudioShell>
</BaseLayout>
